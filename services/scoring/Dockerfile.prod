# Production Dockerfile - build from repository root
# Usage: docker build -f services/scoring/Dockerfile.prod -t scoring-service .

FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY services/scoring/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy SQL templates
COPY sql/scoring /app/sql/scoring

# Copy application code
COPY services/scoring/main.py .

# Run as non-root user
RUN useradd -m -u 1000 appuser
USER appuser

# Cloud Run sets PORT environment variable
ENV PORT=8080
ENV SQL_DIR=/app/sql/scoring

EXPOSE 8080

CMD ["python", "main.py"]
